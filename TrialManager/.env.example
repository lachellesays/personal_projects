# Railway: DATABASE_URL = ${{Postgres.DATABASE_URL}}   (leave out locally to use a SQLite file)
DATABASE_URL=
JOTFORM_API_KEY=your-jotform-api-key
# Long random string that signs login cookies. Generate one with:  python3 -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# The email allowed to create the very first admin account (only works while there are no accounts yet)
BOOTSTRAP_ADMIN_EMAIL=you@example.com
